# ============================================================
# ENVIRONMENT VARIABLES — copy this file to ".env" and fill in
# real values. ".env" is git-ignored so secrets never get committed.
#
# IMPORTANT (Expo specific):
# Any variable prefixed EXPO_PUBLIC_ gets bundled INTO the app
# and is visible to anyone who decompiles the APK. That's fine
# for the Supabase URL + ANON key (they're meant to be public —
# security is enforced by Row Level Security, not secrecy).
#
# The SERVICE_ROLE key and Daraja/SendGrid/Africa's Talking
# secrets must NEVER be prefixed EXPO_PUBLIC_ and must NEVER
# live in the mobile app at all — they belong only in Supabase
# Edge Functions (server-side), set via `supabase secrets set`.
# ============================================================

# --- Used INSIDE the mobile app (safe to expose) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Used ONLY by Supabase Edge Functions (server-side, secret) ---
# Set these with: supabase secrets set KEY=value
# Do NOT put these in the Expo app / do NOT prefix with EXPO_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=247247
AT_USERNAME=
AT_API_KEY=
SENDGRID_API_KEY=
CHAIRMAN_EMAIL=
TREASURER_EMAIL=
